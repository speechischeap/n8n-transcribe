{
  "author": {
    "email": "support@speechischeap.com",
    "name": "Speech is Cheap"
  },
  "description": "Speech is Cheap n8n transcription node",
  "devDependencies": {
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://speechischeap.com",
  "keywords": [
    "asr",
    "automatic speech recognition",
    "n8n",
    "n8n-community-node-package",
    "speech-to-text",
    "speechischeap",
    "stt",
    "transcribe",
    "transcription"
  ],
  "main": "index.js",
  "n8n": {
    "credentials": [
      "dist/credentials/SpeechIsCheapApi.credentials.js"
    ],
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/SpeechIsCheap/SpeechIsCheap.node.js"
    ]
  },
  "name": "@speechischeap/n8n-nodes-transcribe",
  "packageManager": "pnpm@9.1.4",
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/speechischeap/n8n-transcribe"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm build && pnpm lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "version": "0.0.1"
}
